    {
      "type": "table",
      "id": 25,
      "title": "UNKNOWN GPUs now, by reason",
      "description": "Definition: sum(gpus) and distinct assets of open UNKNOWN intervals, by reason_code (SOURCE_STALE, IDENTITY_CONFLICT, CONTESTED, CLUSTER_NOT_OBSERVED, ...).\nUnits: physical GPUs; assets.\nFilters: site.\nUnknown vs zero: '(none)' with 0 = the latest scan has no UNKNOWN GPUs in scope; 'No ledger data yet' = no open intervals at all. UNKNOWN GPUs are never counted as idle, productive or zero. Current state = intervals still open in the ledger (ended_at IS NULL), i.e. the result of the latest engine scan; check 'Data as of' for its age.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ttv-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ttv-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH u AS (\n  SELECT i.reason_code, sum(i.gpus) AS gpus, count(DISTINCT i.asset_id) AS assets\n  FROM capacity_intervals i\n  JOIN assets a ON a.asset_id = i.asset_id\n  WHERE i.ended_at IS NULL AND i.category = 'UNKNOWN'\n    AND ('__all__' IN ($site) OR coalesce(a.site, '(none)') IN ($site))\n  GROUP BY i.reason_code\n)\nSELECT reason_code AS \"Reason\", gpus AS \"UNKNOWN GPUs\", assets AS \"Assets\" FROM u\nUNION ALL\nSELECT '(none)', 0, 0\nWHERE NOT EXISTS (SELECT 1 FROM u)\n  AND EXISTS (SELECT 1 FROM capacity_intervals i JOIN assets a ON a.asset_id = i.asset_id\n              WHERE i.ended_at IS NULL AND ('__all__' IN ($site) OR coalesce(a.site, '(none)') IN ($site)))\nORDER BY 2 DESC, 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": false
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "UNKNOWN GPUs"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
