    {
      "type": "table",
      "id": 26,
      "title": "Assets by source",
      "description": "Definition: assets in the ledger by the source that first registered them (server-scan, profile-less collector, ...): asset count, GPUs per inventory (assets.gpu_count), assets whose GPU count is unread, newest observation and assets not observed in the last hour.\nUnits: assets; GPUs; timestamps in the dashboard timezone.\nFilters: site.\nUnknown vs zero: assets with an unread GPU count are excluded from 'GPUs (inventory)' and counted in their own column, never as 0 GPUs. 'Not seen > 1 h' may be listing lag or a removed asset; a partial listing never closes intervals.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ttv-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ttv-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(a.source, '(none)') AS \"Source\",\n       count(*) AS \"Assets\",\n       sum(a.gpu_count) AS \"GPUs (inventory)\",\n       count(*) FILTER (WHERE a.gpu_count IS NULL) AS \"GPU count unread\",\n       max(a.last_observed_at) AS \"Last observed\",\n       count(*) FILTER (WHERE a.last_observed_at < now() - interval '1 hour') AS \"Not seen > 1 h\"\nFROM assets a\nWHERE ('__all__' IN ($site) OR coalesce(a.site, '(none)') IN ($site))\nGROUP BY 1\nORDER BY 2 DESC, 1"
        }
      ],
      "fieldConfig": {
