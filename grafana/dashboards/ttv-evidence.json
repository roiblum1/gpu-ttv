    {
      "type": "table",
      "id": 19,
      "title": "Recent partial or failed scans",
      "description": "Definition: newest 20 scan_runs in the time range whose status is partial or failed, with their recorded errors and coverage.\nUnits: timestamps in the dashboard timezone.\nFilters: time range.\nUnknown vs zero: an empty table means no partial or failed scan started in the range; check 'Scan runs over time' for gaps where no scan ran at all.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ttv-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ttv-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT started_at AS \"Started\",\n       kind AS \"Kind\",\n       status AS \"Status\",\n       errors::text AS \"Errors\",\n       coverage::text AS \"Coverage\"\nFROM scan_runs\nWHERE status IN ('partial', 'failed') AND $__timeFilter(started_at)\nORDER BY started_at DESC, id DESC\nLIMIT 20"
        }
