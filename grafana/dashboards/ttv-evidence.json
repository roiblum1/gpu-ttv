    {
      "type": "stat",
      "id": 22,
      "title": "Open identity conflicts",
      "description": "Definition: identity_conflicts rows with resolved_at IS NULL (two source records claim one asset id, or a join is ambiguous); and GPUs in open UNKNOWN intervals with reason IDENTITY_CONFLICT.\nUnits: conflicts; GPUs.\nFilters: none.\nUnknown vs zero: 0 conflicts = none recorded. Conflicting assets are never merged silently; their GPUs stay UNKNOWN until resolved.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ttv-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ttv-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (SELECT count(*) FROM identity_conflicts WHERE resolved_at IS NULL) AS \"Open conflicts\",\n       (SELECT coalesce(sum(gpus), 0) FROM capacity_intervals\n         WHERE ended_at IS NULL AND category = 'UNKNOWN' AND reason_code = 'IDENTITY_CONFLICT') AS \"GPUs affected\""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
