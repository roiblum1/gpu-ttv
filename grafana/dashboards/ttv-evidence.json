    {
      "type": "table",
      "id": 18,
      "title": "Last success per scan kind",
      "description": "Definition: per scan kind, finish time of the newest 'ok' run, its age, the status of the newest run of any status, and the number of ok and partial/failed runs started in the time range.\nUnits: timestamps in the dashboard timezone; age as duration; runs as counts.\nFilters: time range (run counts only).\nUnknown vs zero: 'never' = no 'ok' run recorded, shown in purple; an age is never shown as 0 for a kind that has not succeeded.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ttv-postgres"
      },
      "gridPos": {
        "x": 13,
        "y": 1,
        "w": 11,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ttv-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT k.kind AS \"Kind\",\n       ok.last_ok AS \"Last ok scan\",\n       extract(epoch FROM now() - ok.last_ok) AS \"Age\",\n       lr.status AS \"Newest run\",\n       r.ok_runs AS \"ok runs\",\n       r.bad_runs AS \"partial/failed runs\"\nFROM (SELECT DISTINCT kind FROM scan_runs) k\nLEFT JOIN LATERAL (\n  SELECT max(s.finished_at) AS last_ok FROM scan_runs s\n  WHERE s.kind = k.kind AND s.status = 'ok'\n) ok ON true\nLEFT JOIN LATERAL (\n  SELECT s.status FROM scan_runs s\n  WHERE s.kind = k.kind ORDER BY s.started_at DESC, s.id DESC LIMIT 1\n) lr ON true\nLEFT JOIN LATERAL (\n  SELECT count(*) FILTER (WHERE s.status = 'ok') AS ok_runs,\n         count(*) FILTER (WHERE s.status IN ('partial', 'failed')) AS bad_runs\n  FROM scan_runs s\n  WHERE s.kind = k.kind AND $__timeFilter(s.started_at)\n) r ON true\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": false
          }
        },
        "overrides": [
