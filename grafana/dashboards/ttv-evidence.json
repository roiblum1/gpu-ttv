              "id": "byRegexp",
              "options": ".*· failed$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*· dry_run$"
            },
            "properties": [
              {
