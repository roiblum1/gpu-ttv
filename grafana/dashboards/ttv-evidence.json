    {
      "type": "table",
      "id": 21,
      "title": "Source health (source_state)",
      "description": "Definition: engine-side health per source (server-scan, each target cluster, collector targets): consecutive failed scans, last success, last attempt and last error.\nUnits: counts; timestamps in the dashboard timezone; time since success as duration.\nState: 'ok' (green) = last fetch succeeded; 'failing, within grace' (orange) = 1-2 consecutive failures; 'beyond grace: assets UNKNOWN' (red) = 3+ failures, beyond the default unknown_grace_scans of 2, so the source's assets are UNKNOWN; 'never succeeded' (purple) = no complete fetch yet. Thresholds assume the default grace; change the SQL if the policy changes it.\nFilters: none.\nUnknown vs zero: 'never' = the source has not completed a fetch since the engine started tracking it; its assets are UNKNOWN, not empty.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ttv-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ttv-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT name AS \"Source\",\n       CASE WHEN last_success_at IS NULL THEN 'never succeeded'\n            WHEN failed_scans = 0 THEN 'ok'\n            WHEN failed_scans <= 2 THEN 'failing, within grace'\n            ELSE 'beyond grace: assets UNKNOWN' END AS \"State\",\n       failed_scans AS \"Consecutive failed scans\",\n       last_success_at AS \"Last success\",\n       extract(epoch FROM now() - last_success_at) AS \"Since last success\",\n       last_attempt_at AS \"Last attempt\",\n       last_error AS \"Last error\"\nFROM source_state\nORDER BY (last_success_at IS NULL) DESC, failed_scans DESC, name"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": false
          }
        },
