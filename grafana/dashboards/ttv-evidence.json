    {
      "type": "table",
      "id": 23,
      "title": "Open identity conflicts",
      "description": "Definition: unresolved identity_conflicts, oldest first: conflict kind, contested key, candidate source records, first and last seen.\nUnits: timestamps in the dashboard timezone; open-for as duration.\nFilters: none.\nUnknown vs zero: an empty table means no open conflict; resolved conflicts keep their history in the ledger but are not shown.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ttv-postgres"
      },
      "gridPos": {
        "x": 6,
        "y": 23,
        "w": 18,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ttv-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT kind AS \"Kind\",\n       key AS \"Key\",\n       jsonb_array_length(CASE WHEN jsonb_typeof(candidates) = 'array' THEN candidates ELSE '[]'::jsonb END) AS \"Candidates (n)\",\n       candidates::text AS \"Candidates\",\n       first_seen AS \"First seen\",\n       last_seen AS \"Last seen\",\n       extract(epoch FROM now() - first_seen) AS \"Open for\"\nFROM identity_conflicts\nWHERE resolved_at IS NULL\nORDER BY first_seen, id"
        }
      ],
