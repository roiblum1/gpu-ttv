                        "color": "orange",
                        "index": 1
                      },
                      "beyond grace: assets UNKNOWN": {
                        "color": "red",
                        "index": 2
                      },
                      "never succeeded": {
                        "color": "purple",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
