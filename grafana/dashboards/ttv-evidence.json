    {
      "type": "timeseries",
      "id": 17,
      "title": "Scan runs over time, by kind and status",
      "description": "Definition: count of scan_runs by start time bucket, split by kind and status (ok, partial, failed, dry_run, running).\nUnits: scan runs per bucket (bucket = Grafana's interval for the range, at least 5 min).\nFilters: time range.\nUnknown vs zero: a gap means no scan ran (monitoring was blind), which is different from a scan that ran and found nothing. Only 'ok' scans update the ledger as complete; partial listings never close intervals.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ttv-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 13,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ttv-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(started_at, $__interval),\n       kind || ' · ' || status AS metric,\n       count(*) AS runs\nFROM scan_runs\nWHERE $__timeFilter(started_at)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "barAlignment": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisLabel": "scan runs",
            "axisPlacement": "auto",
            "spanNulls": false,
            "gradientMode": "none",
            "pointSize": 4,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*· ok$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*· partial$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
