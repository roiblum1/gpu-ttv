# ttv-engine settings. Copy to .env for local runs; in OpenShift these come from the Deployment env and Secrets.
# Every variable is optional except TTV_SERVERSCAN_URL. Durations accept 90s, 15m, 6h, 1d.

# server-scan (read-only). The token file holds the AUDITOR API token (INVENTORY_API_TOKEN_AUDITOR).
TTV_SERVERSCAN_URL=https://server-scan.example.internal
TTV_SERVERSCAN_TOKEN_FILE=/var/run/secrets/ttv/serverscan-token
# PEM bundle for the internal CA; TLS verification is never disabled.
TTV_CA_BUNDLE=/etc/pki/ttv/ca-bundle.pem

# Ledger database. Leave unset to classify without storing anything.
# Prefer a password from PGPASSFILE / a mounted secret over a password in the URL.
TTV_DATABASE_URL=postgresql://ttv@postgres.ttv.svc:5432/ttv

# Business policy (owners, stage objectives, target clusters, exclusions); see config/policy.example.yaml.
TTV_POLICY_FILE=config/policy.yaml

# Target clusters to read (kube API + Thanos); see config/clusters.example.yaml. Unset: no cluster is read,
# so servers INSTALLED in a target cluster stay UNKNOWN (CLUSTER_NOT_OBSERVED).
TTV_CLUSTERS_FILE=config/clusters.yaml
# Deadline for each cluster source read per scan, and parallel owner lookups per cluster.
TTV_CLUSTER_TIMEOUT_SECONDS=120
TTV_OWNER_LOOKUP_CONCURRENCY=8

# Profile-less GPU collector (ttv-collector, a separate job every 15 min): managers to read; see
# config/managers.example.yaml. The engine treats a manager whose latest complete read is older
# than TTV_COLLECTOR_STALE_AFTER as failing, so its collector-only servers turn UNKNOWN.
TTV_MANAGERS_FILE=config/managers.yaml
TTV_COLLECTOR_TIMEOUT_SECONDS=600
TTV_COLLECTOR_STALE_AFTER=1h

# Writes are off until the dry-run review is done (AGENT.md §20.6). Set to false to write the ledger.
TTV_DRY_RUN=true

TTV_SCAN_INTERVAL_SECONDS=300
TTV_HTTP_TIMEOUT_SECONDS=30
# server-scan detail fetches (one GET per changed server): refresh age, per-scan budget, parallelism.
TTV_DETAIL_TTL=6h
TTV_DETAIL_MAX_PER_SCAN=1000
TTV_DETAIL_CONCURRENCY=8
# Consecutive failed scans before a source's assets turn UNKNOWN; absence before an asset is retired.
TTV_UNKNOWN_GRACE_SCANS=2
TTV_TOMBSTONE_AFTER=24h

# AWS On-Demand pricing (USD). Snapshot files in this directory are verified and imported at startup;
# a tampered file stops the engine. The engine never fetches prices (ADR-0003).
TTV_PRICING_DIR=config/pricing/snapshots
# Present-day snapshot id; unset = the latest published. Set an older id to roll back.
TTV_PRICING_SNAPSHOT=

TTV_API_HOST=0.0.0.0
TTV_API_PORT=8080
